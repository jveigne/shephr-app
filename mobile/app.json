{
  "expo": {
    "name": "shephr",
    "slug": "shephr",
    "version": "0.3.0",
    "sdkVersion": "57.0.0",
    "extra": {
      "API_URL": "https://cmfipraise-prod-production.up.railway.app",
      "GOOGLE_WEB_CLIENT_ID": "921845497694-g1kjo9380t9g9dbtf6n32kk9t9qm8kt1.apps.googleusercontent.com",
      "GOOGLE_IOS_CLIENT_ID": "921845497694-cuugiern2jk9gfsgqvf79k90bfrs8hh4.apps.googleusercontent.com",
      "GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.921845497694-cuugiern2jk9gfsgqvf79k90bfrs8hh4",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5b13d65d-fa12-4271-92f6-2345820f5240"
      }
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "scheme": "shephr",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.cmfi.shephr",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:www.shephr.org"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cmfi.shephr",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.shephr.org",
              "pathPrefix": "/d/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E3A2F",
          "defaultChannel": "default",
          "mode": "production"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.921845497694-cuugiern2jk9gfsgqvf79k90bfrs8hh4"
        }
      ],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "veigne"
  }
}
